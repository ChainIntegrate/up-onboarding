{
  "manifest_version": 3,
  "name": "ChainIntegrate Account",
  "short_name": "ChainIntegrate",
  "version": "0.4.0",
  "key": "",
  "description": "Il tuo accesso all'account ChainIntegrate e ai suoi progetti. / Your access to your ChainIntegrate account and its projects.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "action": {
    "default_title": "ChainIntegrate Account",
    "default_icon": {
      "16": "img/icon-16.png",
      "32": "img/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chainintegrate.it/*"
      ],
      "js": [
        "provider.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.chainintegrate.it/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://account.chainintegrate.it/*",
    "https://rpc.mainnet.lukso.network/*",
    "https://rpc.testnet.lukso.network/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
