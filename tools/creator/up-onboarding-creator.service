# /etc/systemd/system/up-onboarding-creator.service
[Unit]
Description=ChainIntegrate account service (up-onboarding)
After=network-online.target
Wants=network-online.target
# Restarts up to 5 times in 10 minutes; past that systemd gives up and the alert e-mail goes out.
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=up-onboarding-alert@%n.service

[Service]
User=up-onboarding
Group=up-onboarding
WorkingDirectory=/var/www/up-onboarding/tools/creator
Environment=CREATOR_CONFIG=/etc/up-onboarding/config.json
ExecStart=/usr/bin/node creator.js serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/up-onboarding

[Install]
WantedBy=multi-user.target
