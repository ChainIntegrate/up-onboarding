# Copy to /etc/up-onboarding/smtp.env (owner up-onboarding, mode 600) and fill in the password there; the same
# mailbox as Cross_Chain's relayer monitor (/etc/crosschain-relayer/smtp.env). Never commit the real file.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@chainintegrate.it
SMTP_PASS=
SMTP_FROM=no-reply@chainintegrate.it
NOTIFICATION_EMAIL=
